# Copy to .env.local before running `npm run dev`.
# The dev server refuses to start without an explicit API target.
#
# Staging / local backend (recommended):
# VITE_API_PROXY=http://127.0.0.1:8000
#
# Production — mutates live data; use only when you mean it:
# VITE_API_PROXY=https://sanaq.abuyunus.cc

VITE_API_PROXY=
